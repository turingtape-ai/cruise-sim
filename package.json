    "@types/topojson-specification": "^1.0.5",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "playwright": "^1.62.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.7",
